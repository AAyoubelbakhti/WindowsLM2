<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="LinkManager2.Dialogs.EmailShareDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkManager2"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    local:Text.Uid="EmailShare_Dialog"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSendClick">
    <StackPanel Spacing="12" Width="460">
        <TextBlock x:Name="ItemLabel" Opacity="0.75" TextWrapping="Wrap" />
        <TextBox x:Name="EmailBox"
                 local:Text.Uid="EmailShare_EmailBox"
                 InputScope="EmailSmtpAddress" />
        <TextBox x:Name="MessageBox"
                 local:Text.Uid="EmailShare_MessageBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="100"
                 MaxLength="500" />
        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" />
    </StackPanel>
</ContentDialog>
