<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="LinkManager2.Dialogs.ShareLinkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkManager2"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    local:Text.Uid="ShareLink_Dialog"
    DefaultButton="Primary"
    PrimaryButtonClick="OnGenerateClick">
    <StackPanel Spacing="12" Width="460">
        <TextBlock x:Name="ItemLabel" Opacity="0.75" TextWrapping="Wrap" />
        <ComboBox x:Name="ExpiresCombo" local:Text.Uid="ShareLink_ExpiresCombo" HorizontalAlignment="Stretch" />
        <TextBox x:Name="ResultBox"
                 local:Text.Uid="ShareLink_ResultBox"
                 IsReadOnly="True"
                 FontFamily="{StaticResource AppMonoFont}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="CopyButton" local:Text.Uid="ShareLink_CopyButton" IsEnabled="False" Click="OnCopyClick" />
        </StackPanel>
        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" />
    </StackPanel>
</ContentDialog>
