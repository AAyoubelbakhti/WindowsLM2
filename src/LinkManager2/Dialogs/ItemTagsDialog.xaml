<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="LinkManager2.Dialogs.ItemTagsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkManager2"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    local:Text.Uid="ItemTags_Dialog"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSaveClick">
    <Grid Width="440" Height="420" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="ItemLabel"
                   Opacity="0.7"
                   TextWrapping="Wrap" />

        <ListView Grid.Row="1"
                  x:Name="TagsList"
                  local:Text.Uid="ItemTags_TagsList"
                  SelectionMode="Multiple">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewTagBox"
                     local:Text.Uid="ItemTags_NewTagBox"
                     Grid.Column="0" />
            <Button x:Name="CreateButton"
                    local:Text.Uid="ItemTags_CreateButton"
                    Grid.Column="1"
                    Click="OnCreateClick" />
        </Grid>

        <InfoBar Grid.Row="3"
                 x:Name="ErrorBar"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="False" />
    </Grid>
</ContentDialog>
