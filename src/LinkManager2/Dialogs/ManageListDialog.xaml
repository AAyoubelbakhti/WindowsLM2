<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="LinkManager2.Dialogs.ManageListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="ManageList_Dialog">
    <Grid Width="440" Height="500" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView Grid.Row="0"
                  x:Name="ItemsList"
                  x:Uid="ManageList_ItemsList"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="RenameBox"
                     x:Uid="ManageList_RenameBox"
                     Grid.Column="0"
                     IsEnabled="False" />
            <Button x:Name="RenameButton"
                    x:Uid="ManageList_RenameButton"
                    Grid.Column="1"
                    IsEnabled="False"
                    Click="OnRenameClick" />
            <Button x:Name="DeleteButton"
                    x:Uid="ManageList_DeleteButton"
                    Grid.Column="2"
                    IsEnabled="False">
                <Button.Flyout>
                    <Flyout x:Name="DeleteFlyout">
                        <StackPanel Spacing="8" MaxWidth="260">
                            <TextBlock x:Name="DeleteConfirmText"
                                       TextWrapping="Wrap" />
                            <Button x:Uid="ManageList_ConfirmDeleteButton"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnDeleteConfirmClick"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewNameBox"
                     x:Uid="ManageList_NewNameBox"
                     Grid.Column="0" />
            <Button x:Name="AddButton"
                    x:Uid="ManageList_AddButton"
                    Grid.Column="1"
                    Click="OnAddClick" />
        </Grid>

        <InfoBar Grid.Row="3"
                 x:Name="StatusBar"
                 IsOpen="False"
                 IsClosable="False"
                 AutomationProperties.LiveSetting="Polite" />
    </Grid>
</ContentDialog>
