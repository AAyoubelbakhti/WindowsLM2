<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="LinkManager2.Dialogs.SharedDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Compartidos"
    CloseButtonText="Cerrar">
    <Grid Width="480" Height="520" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView Grid.Row="0"
                  x:Name="ItemsList"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  AutomationProperties.Name="Enlaces y colecciones compartidos">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel AutomationProperties.Name="{Binding AccessibleName}">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CopyButton"
                    Grid.Column="1"
                    IsEnabled="False"
                    Content="Copiar enlace"
                    Click="OnCopyClick"
                    AutomationProperties.Name="Copiar la URL pública seleccionada" />
            <Button x:Name="RevokeButton"
                    Grid.Column="2"
                    IsEnabled="False"
                    Content="Revocar"
                    AutomationProperties.Name="Revocar el elemento compartido seleccionado">
                <Button.Flyout>
                    <Flyout x:Name="RevokeFlyout">
                        <StackPanel Spacing="8" MaxWidth="260">
                            <TextBlock x:Name="RevokeConfirmText" TextWrapping="Wrap" />
                            <Button Content="Confirmar revocación"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnRevokeConfirmClick"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <InfoBar Grid.Row="2"
                 x:Name="StatusBar"
                 IsOpen="False"
                 IsClosable="False"
                 AutomationProperties.LiveSetting="Polite" />
    </Grid>
</ContentDialog>
