<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="LinkManager2.Dialogs.AddEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkManager2"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    local:Text.Uid="AddEdit_Dialog"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSaveClick">
    <StackPanel Spacing="12" Width="440">
        <TextBox x:Name="TitleBox"
                 local:Text.Uid="AddEdit_TitleBox" />
        <TextBox x:Name="ValueBox"
                 local:Text.Uid="AddEdit_ValueBox"
                 LostFocus="OnValueLostFocus" />
        <ComboBox x:Name="CategoryCombo"
                  local:Text.Uid="AddEdit_CategoryCombo"
                  HorizontalAlignment="Stretch" />
        <TextBox x:Name="DescriptionBox"
                 local:Text.Uid="AddEdit_DescriptionBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MaxHeight="120" />

        <StackPanel x:Name="QuickCreatePanel" Spacing="8" Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewCategoryBox" Grid.Column="0"
                         local:Text.Uid="AddEdit_NewCategoryBox" />
                <Button x:Name="CreateCategoryButton" Grid.Column="1"
                        local:Text.Uid="AddEdit_CreateCategoryButton" Click="OnCreateCategory" />
            </Grid>

            <TextBlock local:Text.Uid="AddEdit_TagsHeading" Opacity="0.7"
                       AutomationProperties.HeadingLevel="Level2" />
            <ListView x:Name="TagsList" local:Text.Uid="AddEdit_TagsList" SelectionMode="Multiple" MaxHeight="160">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTagBox" Grid.Column="0"
                         local:Text.Uid="AddEdit_NewTagBox" />
                <Button x:Name="CreateTagButton" Grid.Column="1"
                        local:Text.Uid="AddEdit_CreateTagButton" Click="OnCreateTag" />
            </Grid>
        </StackPanel>

        <InfoBar x:Name="ErrorBar"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="False"
                 AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>
</ContentDialog>
