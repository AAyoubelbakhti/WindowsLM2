<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="LinkManager2.Dialogs.ArchivedDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Archivados"
    CloseButtonText="Cerrar">
    <Grid Width="460" Height="500" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView Grid.Row="0"
                  x:Name="ItemsList"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  AutomationProperties.Name="Elementos archivados">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Value}" Opacity="0.7" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RestoreButton"
                    Grid.Column="1"
                    IsEnabled="False"
                    Content="Restaurar"
                    Click="OnRestoreClick"
                    AutomationProperties.Name="Restaurar el elemento seleccionado" />
            <Button x:Name="DeleteButton"
                    Grid.Column="2"
                    IsEnabled="False"
                    Content="Borrar"
                    AutomationProperties.Name="Borrar definitivamente el elemento seleccionado">
                <Button.Flyout>
                    <Flyout x:Name="DeleteFlyout">
                        <StackPanel Spacing="8" MaxWidth="260">
                            <TextBlock x:Name="DeleteConfirmText" TextWrapping="Wrap" />
                            <Button Content="Confirmar borrado"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnDeleteConfirmClick"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <InfoBar Grid.Row="2"
                 x:Name="StatusBar"
                 IsOpen="False"
                 IsClosable="False"
                 AutomationProperties.LiveSetting="Polite" />
    </Grid>
</ContentDialog>
