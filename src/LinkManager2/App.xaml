<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LinkManager2.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkManager2">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <Color x:Key="SystemAccentColor">#C2410C</Color>
                            <Color x:Key="SystemAccentColorLight1">#CD6338</Color>
                            <Color x:Key="SystemAccentColorLight2">#D88563</Color>
                            <Color x:Key="SystemAccentColorLight3">#E3A88F</Color>
                            <Color x:Key="SystemAccentColorDark1">#A3370A</Color>
                            <Color x:Key="SystemAccentColorDark2">#882E08</Color>
                            <Color x:Key="SystemAccentColorDark3">#6D2407</Color>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <Color x:Key="SystemAccentColor">#FB923C</Color>
                            <Color x:Key="SystemAccentColorLight1">#FCA65F</Color>
                            <Color x:Key="SystemAccentColorLight2">#FCB982</Color>
                            <Color x:Key="SystemAccentColorLight3">#FDCDA5</Color>
                            <Color x:Key="SystemAccentColorDark1">#D37B32</Color>
                            <Color x:Key="SystemAccentColorDark2">#B0662A</Color>
                            <Color x:Key="SystemAccentColorDark3">#8D5222</Color>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppMonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
