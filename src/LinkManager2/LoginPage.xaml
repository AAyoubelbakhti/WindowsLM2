<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LinkManager2.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkManager2"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="0,32,0,32">
            <StackPanel Width="380"
                        HorizontalAlignment="Center"
                        Spacing="14"
                        Padding="24">

                <StackPanel Spacing="4">
                    <TextBlock local:Text.Uid="Login_Title"
                               FontSize="28"
                               FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="SubtitleText"
                               local:Text.Uid="Login_SubtitleText"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="ErrorBar"
                         IsOpen="False"
                         Severity="Error"
                         IsClosable="True"
                         AutomationProperties.LiveSetting="Assertive" />

                <InfoBar x:Name="InfoBarMsg"
                         IsOpen="False"
                         Severity="Success"
                         IsClosable="True"
                         AutomationProperties.LiveSetting="Polite" />

                <StackPanel Spacing="6">
                    <TextBlock local:Text.Uid="Login_ModeLabel" Opacity="0.7" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton x:Name="SignInMode"
                                     local:Text.Uid="Login_SignInMode"
                                     IsChecked="True"
                                     GroupName="AuthMode"
                                     Checked="OnModeChanged" />
                        <RadioButton x:Name="SignUpMode"
                                     local:Text.Uid="Login_SignUpMode"
                                     GroupName="AuthMode"
                                     Checked="OnModeChanged" />
                    </StackPanel>
                </StackPanel>

                <TextBox x:Name="EmailBox"
                         local:Text.Uid="Login_EmailBox"
                         InputScope="EmailSmtpAddress" />

                <PasswordBox x:Name="PasswordBox"
                             local:Text.Uid="Login_PasswordBox" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SubmitButton"
                            local:Text.Uid="Login_SubmitButton"
                            Grid.Column="0"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="OnSubmit" />
                    <ProgressRing x:Name="BusyRing"
                                  local:Text.Uid="Login_BusyRing"
                                  Grid.Column="1"
                                  Width="20" Height="20"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center" />
                </Grid>

                <HyperlinkButton x:Name="ForgotButton"
                                 local:Text.Uid="Login_ForgotButton"
                                 Padding="0,4"
                                 Click="OnForgotPassword" />

                <Expander x:Name="OtherMethodsExpander"
                          local:Text.Uid="Login_OtherMethodsExpander"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <TextBlock local:Text.Uid="Login_OtherMethodsNote"
                                   TextWrapping="Wrap"
                                   Opacity="0.7"
                                   FontSize="12" />
                        <Button x:Name="GitHubButton"
                                local:Text.Uid="Login_GitHubButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="OnGitHubSignIn" />
                        <Button x:Name="DiscordButton"
                                local:Text.Uid="Login_DiscordButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="OnDiscordSignIn" />
                    </StackPanel>
                </Expander>

                <StackPanel Spacing="2" Margin="0,8,0,0">
                    <HyperlinkButton x:Name="SignUpWebButton"
                                     local:Text.Uid="Login_SignUpWebButton"
                                     HorizontalAlignment="Center"
                                     Padding="0,4"
                                     Click="OnSignUpWeb" />
                    <TextBlock local:Text.Uid="Login_SignUpWebNote"
                               TextWrapping="Wrap"
                               Opacity="0.55"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
