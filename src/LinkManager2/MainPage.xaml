<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LinkManager2.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkManager2"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16,12,16,8" RowSpacing="10">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0"
                    DefaultLabelPosition="Right"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    IsOpen="False"
                    OverflowButtonVisibility="Visible">
            <AppBarButton x:Name="AddButton" local:Text.Uid="Main_AddButton" Icon="Add"
                          Click="OnAddClick">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="SettingsButton" local:Text.Uid="Main_SettingsButton" Icon="Setting"
                          Click="OnSettingsClick" />

            <CommandBar.SecondaryCommands>
                <AppBarButton local:Text.Uid="Main_ManageCategories" Click="OnManageCategoriesClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8FD;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton local:Text.Uid="Main_ManageTags" Click="OnManageTagsClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8EC;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton local:Text.Uid="Main_Import" Click="OnImportClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B5;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton local:Text.Uid="Main_Export" Click="OnExportClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton local:Text.Uid="Main_ShareCollection" Click="OnShareCollectionClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE71D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton local:Text.Uid="Main_ManageShared" Click="OnManageSharedClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton local:Text.Uid="Main_Archived" Click="OnArchivedClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7B8;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton local:Text.Uid="Main_CheckLinks" Click="OnCheckLinksClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE945;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton local:Text.Uid="Main_Reload" Click="OnReloadClick">
                    <AppBarButton.Icon><SymbolIcon Symbol="Refresh" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton local:Text.Uid="Main_OpenWeb" Click="OnOpenWebClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE774;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton local:Text.Uid="Main_Shortcuts" Click="OnHelpClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE897;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton local:Text.Uid="Main_SignOut" Click="OnSignOutClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xF3B1;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox"
                            local:Text.Uid="Main_SearchBox"
                            Grid.Column="0"
                            QueryIcon="Find"
                            TextChanged="OnSearchChanged"
                            SuggestionChosen="OnSuggestionChosen" />
            <Button x:Name="FiltersButton"
                    local:Text.Uid="Main_FiltersButton"
                    Grid.Column="1"
                    Click="OnFiltersClick">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="L" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <TextBlock Grid.Row="2"
                   x:Name="FiltersStatus"
                   Opacity="0.85"
                   FontSize="12"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />

        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
            <ListView x:Name="ItemsList"
                      local:Text.Uid="Main_ItemsList"
                      SelectionMode="Extended"
                      ItemsSource="{x:Bind Visible}"
                      DoubleTapped="OnItemDoubleTapped"
                      KeyDown="OnListKeyDown"
                      RightTapped="OnListRightTapped"
                      SelectionChanged="OnSelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,10" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ItemViewModel">

                        <Grid AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                              AutomationProperties.HelpText="{x:Bind Details, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind Details, Mode=OneWay}">
                            <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextFlyout>
                    <MenuFlyout x:Name="ItemContextMenu" Opening="OnContextMenuOpening">
                        <MenuFlyoutItem local:Text.Uid="Main_MenuOpen" Click="OnOpenClick">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="OpenFile" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem local:Text.Uid="Main_MenuCopy" Tag="copy" Click="OnCopyClick">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem local:Text.Uid="Main_MenuShare" Tag="share" Click="OnShareClick" />
                        <MenuFlyoutItem local:Text.Uid="Main_MenuEmail" Tag="email" Click="OnEmailClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem local:Text.Uid="Main_MenuEdit" Tag="edit" Click="OnEditClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="E" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem local:Text.Uid="Main_MenuTags" Tag="tags" Click="OnEditTagsClick" />
                        <MenuFlyoutItem local:Text.Uid="Main_MenuHistory" Tag="history" Click="OnHistoryClick" />
                        <MenuFlyoutItem local:Text.Uid="Main_MenuPublicLink" Tag="publink" Click="OnShareLinkClick" />
                        <MenuFlyoutItem local:Text.Uid="Main_MenuCheck" Tag="check" Click="OnCheckLinkClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="FavoriteMenuItem" local:Text.Uid="Main_FavoriteMenuItem" Click="OnFavoriteClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem local:Text.Uid="Main_MenuArchive" Tag="archive" Click="OnArchiveClick">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="MoveToFolder" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem local:Text.Uid="Main_MenuDelete" Click="OnDeleteClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Delete" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>

            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        MaxWidth="320"
                        AutomationProperties.LiveSetting="Polite">
                <FontIcon Glyph="&#xE71B;" FontSize="32" Opacity="0.5" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyStateText"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Opacity="0.85" />
            </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    x:Name="BulkBar"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
            <TextBlock x:Name="BulkCountText"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <Button local:Text.Uid="Main_BulkOpen" Click="OnBulkOpenClick" />
            <Button local:Text.Uid="Main_BulkCopy" Click="OnBulkCopyClick" />
            <Button local:Text.Uid="Main_BulkCollection" Click="OnBulkCollectionClick" />
            <Button local:Text.Uid="Main_BulkDelete" Click="OnBulkDeleteClick" />
        </StackPanel>

        <TextBlock Grid.Row="5"
                   x:Name="DetailsText"
                   local:Text.Uid="Main_DetailsText"
                   Opacity="0.85"
                   FontSize="12"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="6"
                   x:Name="StatusText"
                   local:Text.Uid="Main_StatusText"
                   Opacity="0.9"
                   FontSize="12"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
