<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LinkManager2.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkManager2"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16,12,16,8" RowSpacing="10">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0"
                    DefaultLabelPosition="Right"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    IsOpen="False"
                    OverflowButtonVisibility="Visible">
            <AppBarButton x:Name="AddButton" Icon="Add" Label="Añadir enlace"
                          ToolTipService.ToolTip="Añadir un enlace o ruta (Ctrl+N)"
                          AutomationProperties.Name="Añadir enlace"
                          Click="OnAddClick">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="SettingsButton" Icon="Setting" Label="Ajustes"
                          ToolTipService.ToolTip="Abrir ajustes"
                          AutomationProperties.Name="Abrir ajustes"
                          Click="OnSettingsClick" />

            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Gestionar categorías" Click="OnManageCategoriesClick"
                              AutomationProperties.Name="Gestionar categorías">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8FD;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Gestionar etiquetas" Click="OnManageTagsClick"
                              AutomationProperties.Name="Gestionar etiquetas">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8EC;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Importar…" Click="OnImportClick"
                              AutomationProperties.Name="Importar JSON o SQLite">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B5;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Exportar JSON…" Click="OnExportClick"
                              AutomationProperties.Name="Exportar enlaces a JSON">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Crear colección pública…" Click="OnShareCollectionClick"
                              AutomationProperties.Name="Crear una colección pública con los enlaces visibles">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE71D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Compartidos…" Click="OnManageSharedClick"
                              AutomationProperties.Name="Ver y revocar enlaces y colecciones compartidos">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Archivados…" Click="OnArchivedClick"
                              AutomationProperties.Name="Ver elementos archivados y restaurarlos">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7B8;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Comprobar enlaces rotos" Click="OnCheckLinksClick"
                              AutomationProperties.Name="Comprobar todos los enlaces en busca de rotos">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE945;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Recargar" Click="OnReloadClick"
                              AutomationProperties.Name="Recargar lista desde Supabase (F5)">
                    <AppBarButton.Icon><SymbolIcon Symbol="Refresh" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Abrir versión web" Click="OnOpenWebClick"
                              AutomationProperties.Name="Abrir el cliente web">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE774;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Atajos de teclado" Click="OnHelpClick"
                              AutomationProperties.Name="Ver atajos de teclado">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE897;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Cerrar sesión" Click="OnSignOutClick"
                              AutomationProperties.Name="Cerrar sesión y volver al inicio">
                    <AppBarButton.Icon><FontIcon Glyph="&#xF3B1;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="0"
                            QueryIcon="Find"
                            PlaceholderText="Buscar por título, URL o descripción…"
                            TextChanged="OnSearchChanged"
                            SuggestionChosen="OnSuggestionChosen"
                            AutomationProperties.Name="Buscar por título, URL o descripción" />
            <Button x:Name="FiltersButton"
                    Grid.Column="1"
                    Content="Filtros"
                    Click="OnFiltersClick"
                    AutomationProperties.Name="Abrir filtros">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="L" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <TextBlock Grid.Row="2"
                   x:Name="FiltersStatus"
                   Opacity="0.85"
                   FontSize="12"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />

        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
            <ListView x:Name="ItemsList"
                      SelectionMode="Extended"
                      ItemsSource="{x:Bind Visible}"
                      DoubleTapped="OnItemDoubleTapped"
                      KeyDown="OnListKeyDown"
                      RightTapped="OnListRightTapped"
                      SelectionChanged="OnSelectionChanged"
                      AutomationProperties.Name="Lista de enlaces guardados. Usa Ctrl o Mayús para seleccionar varios.">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,10" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ItemViewModel">

                        <Grid AutomationProperties.Name="{x:Bind AccessibleName}"
                              AutomationProperties.HelpText="{x:Bind Details}"
                              ToolTipService.ToolTip="{x:Bind Details}">
                            <TextBlock Text="{x:Bind DisplayTitle}"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextFlyout>
                    <MenuFlyout x:Name="ItemContextMenu" Opening="OnContextMenuOpening">
                        <MenuFlyoutItem Text="Abrir" Click="OnOpenClick">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="OpenFile" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Copiar URL" Tag="copy" Click="OnCopyClick"
                                        KeyboardAcceleratorTextOverride="Ctrl+C">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Compartir…" Tag="share" Click="OnShareClick" />
                        <MenuFlyoutItem Text="Enviar por email…" Tag="email" Click="OnEmailClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Editar…" Tag="edit" Click="OnEditClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="E" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Etiquetas…" Tag="tags" Click="OnEditTagsClick" />
                        <MenuFlyoutItem Text="Historial…" Tag="history" Click="OnHistoryClick" />
                        <MenuFlyoutItem Text="Crear enlace público…" Tag="publink" Click="OnShareLinkClick" />
                        <MenuFlyoutItem Text="Comprobar si está roto" Tag="check" Click="OnCheckLinkClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="FavoriteMenuItem" Text="Marcar como favorito" Click="OnFavoriteClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Archivar" Tag="archive" Click="OnArchiveClick">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="MoveToFolder" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Borrar" Click="OnDeleteClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Delete" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>

            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        MaxWidth="320"
                        AutomationProperties.LiveSetting="Polite">
                <FontIcon Glyph="&#xE71B;" FontSize="32" Opacity="0.5" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyStateText"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Opacity="0.85" />
            </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    x:Name="BulkBar"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
            <TextBlock x:Name="BulkCountText"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <Button Content="Abrir" Click="OnBulkOpenClick"
                    AutomationProperties.Name="Abrir los seleccionados" />
            <Button Content="Copiar" Click="OnBulkCopyClick"
                    AutomationProperties.Name="Copiar las URL de los seleccionados" />
            <Button Content="Crear colección…" Click="OnBulkCollectionClick"
                    AutomationProperties.Name="Crear colección con los seleccionados" />
            <Button Content="Borrar…" Click="OnBulkDeleteClick"
                    AutomationProperties.Name="Borrar los seleccionados" />
        </StackPanel>

        <TextBlock Grid.Row="5"
                   x:Name="DetailsText"
                   Opacity="0.85"
                   FontSize="12"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="Detalles del elemento seleccionado" />

        <TextBlock Grid.Row="6"
                   x:Name="StatusText"
                   Text="Listo."
                   Opacity="0.9"
                   FontSize="12"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
