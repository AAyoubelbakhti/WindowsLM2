<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LinkManager2</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>
    <WinUISDKReferences>false</WinUISDKReferences>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- One language per Strings/<tag>/Resources.resw: the app reads this list to offer them, and it sets SatelliteResourceLanguages. Unescape keeps the semicolons as separators. -->
  <PropertyGroup>
    <AppLanguageFiles>$([System.IO.Directory]::GetFiles('$(MSBuildProjectDirectory)\Strings', 'Resources.resw', 'System.IO.SearchOption.AllDirectories'))</AppLanguageFiles>
    <AppLanguages>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(AppLanguageFiles)', '[^;]*\\([^\\]+)\\Resources\.resw', '$1'))))</AppLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="AppLanguages" Value="$(AppLanguages)" />
  </ItemGroup>

  <!-- The texts of the default language, which a translation loaded from a file is checked against. -->
  <ItemGroup>
    <EmbeddedResource Include="Strings\$(DefaultLanguage)\Resources.resw" LogicalName="Base.resw" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <UnusedWinAppSdkComponent Include="AI;Search;Widgets" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WinAppSdkVersion)" />
    <PackageReference Include="@(UnusedWinAppSdkComponent->'Microsoft.WindowsAppSDK.%(Identity)')" Version="$(WinAppSdkVersion)" Publish="false" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.5.96" Publish="false" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.8.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Supabase" Version="8.11.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>

    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Each tag and its bare language, because the SDK matches satellite folders exactly: pt-BR needs pt-BR, es-ES needs es. -->
    <SatelliteResourceLanguages>$(AppLanguages);$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(AppLanguages)', '-[^;]+', ''))))</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Keeps the publish folder to what the app loads: no .winmd metadata, no WinUI strings for languages outside SatelliteResourceLanguages and no payload of the unused SDK components. -->
  <Target Name="TrimWindowsAppSdkPayload" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <PropertyGroup>
      <UnusedComponentFolder>(?i)[\\/]microsoft\.windowsappsdk\.(@(UnusedWinAppSdkComponent, '|'))[\\/]</UnusedComponentFolder>
      <KeptMuiFolder>(?i)^($(SatelliteResourceLanguages.Replace(';', '|')))(-[^\\]+)?\\</KeptMuiFolder>
    </PropertyGroup>
    <ItemGroup>
      <TrimmedPayloadFile Include="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.winmd'" />
      <TrimmedPayloadFile Include="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(FullPath)', '$(UnusedComponentFolder)'))" />
      <TrimmedPayloadFile Include="@(ResolvedFileToPublish)" Condition="'$(SatelliteResourceLanguages)' != '' and '%(Extension)' == '.mui' and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '$(KeptMuiFolder)'))" />
      <ResolvedFileToPublish Remove="@(TrimmedPayloadFile)" />
    </ItemGroup>
  </Target>
  <!-- The made-up languages of aelbak-platform/packages/translations only ever go in a test build. -->
  <Target Name="NoMadeUpLanguage" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release' and (Exists('Strings\qps-Ploc') or Exists('Strings\ar-XB'))">
    <Error Text="Strings has a made-up language, which only goes in a test build: delete it" />
  </Target>
</Project>