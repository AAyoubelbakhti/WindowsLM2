<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LinkManager2.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeBack" />
    </Page.KeyboardAccelerators>
    <ScrollViewer Padding="24,12,24,24">
        <StackPanel Spacing="18" MaxWidth="640" HorizontalAlignment="Stretch">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeadingText" Text="Ajustes" FontSize="24" FontWeight="SemiBold"
                           IsTabStop="True"
                           AutomationProperties.HeadingLevel="Level1" />
                <Button Grid.Column="1" Content="Volver" Click="OnBack"
                        AutomationProperties.Name="Volver a la lista" />
            </Grid>

            <TextBlock Text="Cuenta" FontSize="18" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level2" />
            <Expander Header="Perfil" IsExpanded="True" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" Padding="0,8">
                    <TextBox x:Name="DisplayNameBox"
                             Header="Nombre público"
                             MaxLength="60"
                             AutomationProperties.Name="Nombre público"
                             AutomationProperties.HelpText="Aparece en la web. No se muestra tu email." />
                    <HyperlinkButton Content="Gestionar cuenta y contraseña en aelbak.dev"
                                     NavigateUri="https://aelbak.dev/cuenta"
                                     AutomationProperties.Name="Gestionar cuenta y contraseña en aelbak.dev" />
                </StackPanel>
            </Expander>

            <TextBlock Text="Apariencia" FontSize="18" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level2" />
            <Expander Header="Tema" IsExpanded="True" HorizontalAlignment="Stretch">
                <RadioButtons x:Name="ThemeRadios"
                              Header="Tema de la aplicación"
                              SelectionChanged="OnThemeChanged"
                              AutomationProperties.Name="Tema de la aplicación">
                    <RadioButton Content="Seguir a Windows" Tag="system"
                                 AutomationProperties.Name="Seguir el tema de Windows" />
                    <RadioButton Content="Claro" Tag="light"
                                 AutomationProperties.Name="Tema claro" />
                    <RadioButton Content="Oscuro" Tag="dark"
                                 AutomationProperties.Name="Tema oscuro" />
                </RadioButtons>
            </Expander>

            <TextBlock Text="Enlaces" FontSize="18" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level2" />
            <Expander Header="Acciones visibles en el menú contextual" IsExpanded="True" HorizontalAlignment="Stretch">
                <StackPanel x:Name="ActionsPanel" Spacing="6" Padding="0,8" />
            </Expander>
            <Expander Header="Historial" IsExpanded="False" HorizontalAlignment="Stretch">
                <ToggleSwitch x:Name="HistoryToggle"
                              Header="Habilitar historial por elemento"
                              OnContent="Activado" OffContent="Desactivado"
                              AutomationProperties.Name="Activar historial"
                              AutomationProperties.HelpText="Registra cada creación, modificación o borrado." />
            </Expander>
            <Expander Header="Privacidad al compartir" IsExpanded="False" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" Padding="0,8">
                    <TextBlock Text="Desactivado por defecto. Si lo activas, quien abra tus enlaces públicos verá la categoría y/o las etiquetas que les asignaste."
                               TextWrapping="Wrap" Opacity="0.7" />
                    <ToggleSwitch x:Name="ShareCategoriesToggle"
                                  Header="Mostrar la categoría en mis enlaces públicos"
                                  OnContent="Activado" OffContent="Desactivado"
                                  AutomationProperties.Name="Mostrar la categoría en enlaces públicos" />
                    <ToggleSwitch x:Name="ShareTagsToggle"
                                  Header="Mostrar las etiquetas en mis enlaces públicos"
                                  OnContent="Activado" OffContent="Desactivado"
                                  AutomationProperties.Name="Mostrar las etiquetas en enlaces públicos" />
                </StackPanel>
            </Expander>

            <TextBlock Text="Este equipo" FontSize="18" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level2" />
            <Expander Header="Ventana y sistema" IsExpanded="True" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" Padding="0,8">
                    <ToggleSwitch x:Name="MicaToggle"
                                  Header="Fondo translúcido Mica"
                                  OnContent="Activado" OffContent="Desactivado"
                                  AutomationProperties.Name="Fondo translúcido Mica" />
                    <ToggleSwitch x:Name="TrayToggle"
                                  Header="Al cerrar, minimizar a la bandeja del sistema"
                                  OnContent="Activado" OffContent="Desactivado"
                                  AutomationProperties.Name="Minimizar a la bandeja al cerrar"
                                  AutomationProperties.HelpText="Si está activado, cerrar la ventana solo la oculta. Para salir usa el menú de la bandeja → Salir." />
                    <ToggleSwitch x:Name="HotkeyToggle"
                                  Header="Atajo global para abrir la ventana"
                                  OnContent="Activado" OffContent="Desactivado"
                                  AutomationProperties.Name="Atajo global de teclado" />
                    <ToggleButton x:Name="HotkeyCaptureButton"
                                  Click="OnHotkeyCaptureClick"
                                  KeyDown="OnHotkeyCaptureKeyDown"
                                  HorizontalAlignment="Left"
                                  AutomationProperties.Name="Cambiar la combinación del atajo global"
                                  AutomationProperties.HelpText="Actívalo y pulsa la nueva combinación con Ctrl, Mayús o Alt más una tecla." />
                    <ToggleSwitch x:Name="StartupToggle"
                                  Header="Abrir LinkManager al iniciar Windows"
                                  OnContent="Activado" OffContent="Desactivado"
                                  AutomationProperties.Name="Abrir al iniciar Windows" />
                    <ToggleSwitch x:Name="NotificationsToggle"
                                  Header="Mostrar notificaciones del sistema"
                                  OnContent="Activado" OffContent="Desactivado"
                                  AutomationProperties.Name="Mostrar notificaciones del sistema"
                                  AutomationProperties.HelpText="Avisa al descargar actualizaciones, al sincronizar la cola sin conexión y al guardar enlaces desde la bandeja." />
                </StackPanel>
            </Expander>
            <Expander Header="Actualizaciones" IsExpanded="False" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" Padding="0,8">
                    <TextBlock Text="LinkManager se actualiza solo en segundo plano. También puedes comprobarlo ahora."
                               TextWrapping="Wrap" Opacity="0.8" />
                    <Button x:Name="CheckUpdatesButton" Content="Buscar actualizaciones"
                            Click="OnCheckUpdates"
                            AutomationProperties.Name="Buscar actualizaciones ahora" />
                    <InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="False" />
                </StackPanel>
            </Expander>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <InfoBar Grid.Column="0"
                         x:Name="StatusBar"
                         IsOpen="False"
                         IsClosable="False" />
                <Button Grid.Column="1" Content="Guardar"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSave"
                        AutomationProperties.Name="Guardar todos los ajustes" />
            </Grid>

            <TextBlock Text="Avanzado" FontSize="18" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level2" />
            <HyperlinkButton Content="Política de privacidad"
                             NavigateUri="https://lm.aelbak.dev/privacidad"
                             AutomationProperties.Name="Abrir la política de privacidad" />
            <Expander Header="Zona de peligro" IsExpanded="False" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" Padding="0,8">
                    <TextBlock Text="Eliminar tu cuenta borra de forma permanente tu cuenta y todos tus datos (enlaces, categorías, etiquetas, ajustes y enlaces compartidos). No se puede deshacer."
                               TextWrapping="Wrap" Opacity="0.8" />
                    <Button x:Name="DeleteAccountButton"
                            Content="Eliminar cuenta"
                            Click="OnDeleteAccount"
                            AutomationProperties.Name="Eliminar mi cuenta de forma permanente" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
