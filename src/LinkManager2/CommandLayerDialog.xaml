<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="LinkManager2.CommandLayerDialog"
    local:Text.Uid="Layer_Dialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkManager2"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="Close">
    <StackPanel Spacing="6">
        <TextBlock local:Text.Uid="Layer_Prompt" />
        <TextBlock local:Text.Uid="Layer_KeyG" />
        <TextBlock local:Text.Uid="Layer_KeyF" />
        <TextBlock local:Text.Uid="Layer_KeyL" />
        <TextBlock local:Text.Uid="Layer_KeyR" />
        <TextBlock local:Text.Uid="Layer_KeyA" />
        <TextBlock local:Text.Uid="Layer_KeyP" />
        <TextBlock local:Text.Uid="Layer_KeyH" />
    </StackPanel>
</ContentDialog>
