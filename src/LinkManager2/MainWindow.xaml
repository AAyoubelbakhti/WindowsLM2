<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LinkManager2.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LinkManager2"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LinkManager"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="LinkManager"
                  IsBackButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Frame x:Name="RootFrameControl" Grid.Row="1" />

        <TextBlock x:Name="WindowStatusText"
                   Grid.Row="2"
                   Margin="16,0,16,6"
                   FontSize="12"
                   Opacity="0.9"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />

        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="ms-appx:///Assets/AppIcon.ico"
                        ToolTipText="LinkManager (Ctrl+Shift+L para abrir)"
                        NoLeftClickDelay="True"
                        LeftClickCommand="{x:Bind ShowFromTrayCommand}"
                        Visibility="Collapsed">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Mostrar LinkManager" Command="{x:Bind ShowFromTrayCommand}" />
                    <MenuFlyoutItem Text="Añadir enlace…" Command="{x:Bind AddLinkCommand}" />
                    <MenuFlyoutItem Text="Guardar portapapeles" Command="{x:Bind SaveClipboardCommand}" />
                    <MenuFlyoutItem Text="Buscar" Command="{x:Bind SearchCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Salir" Command="{x:Bind ExitCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
